<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Cartell.Hero" parent="">
        <item name="android:fontFamily">@font/archivo</item>
        <item name="android:fontVariationSettings" tools:targetApi="p">"'wght' 800, 'wdth' 62"</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">72sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Cartell.Title" parent="">
        <item name="android:fontFamily">@font/archivo</item>
        <item name="android:fontVariationSettings" tools:targetApi="p">"'wght' 800, 'wdth' 70"</item>
        <item name="android:textColor">@color/tx</item>
        <item name="android:textSize">44sp</item>
        <item name="android:lineSpacingMultiplier">0.92</item>
        <item name="android:letterSpacing">-0.005</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Cartell.Body" parent="">
        <item name="android:fontFamily">@font/archivo</item>
        <item name="android:fontVariationSettings" tools:targetApi="p">"'wght' 450, 'wdth' 100"</item>
        <item name="android:textColor">@color/tx_2</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="Cartell.Label" parent="Cartell.Body">
        <item name="android:fontVariationSettings" tools:targetApi="p">"'wght' 600, 'wdth' 100"</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Cartell.Value" parent="">
        <item name="android:fontFamily">@font/archivo</item>
        <item name="android:fontVariationSettings" tools:targetApi="p">"'wght' 700, 'wdth' 100"</item>
        <item name="android:textColor">@color/tx</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Cartell.Field" parent="">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:fontFamily">@font/archivo</item>
        <item name="android:fontVariationSettings" tools:targetApi="p">"'wght' 550, 'wdth' 100"</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="android:textColorHint">@color/on_bone_muted</item>
        <item name="android:textSize">17sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="Cartell.Chip" parent="">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:fontFamily">@font/archivo</item>
        <item name="android:fontVariationSettings" tools:targetApi="p">"'wght' 700, 'wdth' 100"</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Cartell.Button" parent="Widget.AppCompat.Button">
        <item name="android:fontFamily">@font/archivo</item>
        <item name="android:fontVariationSettings" tools:targetApi="o">"'wght' 750, 'wdth' 100"</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>