<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".SecondActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                style="@style/Cartell.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/num_second" />

            <TextView
                style="@style/Cartell.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/step_second" />
        </LinearLayout>

        <TextView
            style="@style/Cartell.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/title_second" />

        <!-- Entrada con los datos (TextView = no editables) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_ticket"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp">

                <TextView
                    style="@style/Cartell.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_titular"
                    android:textColor="@color/on_bone_muted" />

                <TextView
                    android:id="@+id/tvNombre"
                    style="@style/Cartell.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/on_brand"
                    android:textSize="40sp"
                    tools:text="@string/sample_nombre" />

                <TextView
                    style="@style/Cartell.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_apellidos"
                    android:textColor="@color/on_bone_muted" />

                <TextView
                    android:id="@+id/tvApellidos"
                    style="@style/Cartell.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/on_brand"
                    android:textSize="26sp"
                    tools:text="@string/sample_apellidos" />
            </LinearLayout>

            <!-- Perforación -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="20dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/divider_dashed"
                    android:layerType="software" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="-10dp"
                    android:background="@drawable/notch" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end"
                    android:layout_marginEnd="-10dp"
                    android:background="@drawable/notch" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Cartell.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_edad"
                        android:textColor="@color/on_bone_muted" />

                    <TextView
                        android:id="@+id/tvEdad"
                        style="@style/Cartell.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_brand"
                        android:textSize="32sp"
                        tools:text="@string/sample_edad" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Cartell.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_matriculado"
                        android:textColor="@color/on_bone_muted" />

                    <TextView
                        android:id="@+id/tvMatriculado"
                        style="@style/Cartell.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/on_brand"
                        android:textSize="32sp"
                        tools:text="@string/sample_matriculado" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Política de confidencialidad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/cbPolitica"
                style="@style/Cartell.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:button="@drawable/sel_checkbox"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:text="@string/cb_politica"
                app:buttonTint="@null" />

            <TextView
                style="@style/Cartell.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="42dp"
                android:text="@string/cb_politica_hint"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSalir"
            style="@style/Cartell.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="@string/btn_salir" />

    </LinearLayout>
</ScrollView>
